<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#0B0F12">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ECRINTEL"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/widgetMarkets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="BTC — · GOLD —"
        android:textSize="13sp"
        android:textColor="#B7FF3C"
        android:maxLines="2" />

    <TextView
        android:id="@+id/widgetHeadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Monitoring global intelligence"
        android:textSize="12sp"
        android:textColor="#D7DEE7"
        android:maxLines="3"
        android:ellipsize="end" />
</LinearLayout>
